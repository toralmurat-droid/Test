{
  "name": "pixel-town-brawl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "live": "node scripts/live.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --target=node22 --sourcemap --outfile=server-dist/index.cjs --log-level=warning",
    "bench": "node tools/perf/run.mjs",
    "start": "NODE_ENV=production node --enable-source-maps server-dist/index.cjs",
    "art": "tsx tools/art/generate.ts"
  },
  "dependencies": {
    "@colyseus/schema": "2.0.37",
    "@colyseus/ws-transport": "0.15.3",
    "colyseus": "0.15.57",
    "express": "4.21.2",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@napi-rs/canvas": "0.1.65",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "colyseus.js": "0.15.28",
    "concurrently": "9.1.0",
    "esbuild": "0.23.1",
    "phaser": "3.90.0",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
