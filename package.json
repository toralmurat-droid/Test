{
  "name": "pixel-town-brawl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "live": "node scripts/live.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "art": "tsx tools/art/generate.ts"
  },
  "dependencies": {
    "@colyseus/schema": "2.0.37",
    "@colyseus/ws-transport": "0.15.3",
    "colyseus": "0.15.57",
    "express": "4.21.2",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "colyseus.js": "0.15.28",
    "concurrently": "9.1.0",
    "phaser": "3.90.0",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
